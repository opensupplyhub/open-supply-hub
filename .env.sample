# Note: You will need to restart the server to pick up changes to these variables.
GOOGLE_SERVER_SIDE_API_KEY=
REACT_APP_GOOGLE_CLIENT_SIDE_API_KEY=
REACT_APP_GOOGLE_ANALYTICS_KEY=
REACT_APP_DROMO_LICENSE_KEY=
REACT_APP_DROMO_SCHEMA_ID=
HUBSPOT_API_KEY=
HUBSPOT_SUBSCRIPTION_ID=
EXTERNAL_DOMAIN=
AWS_S3_ENDPOINT_URL=
AWS_REGION=
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional, local dev only: name of an AWS CLI profile (from your ~/.aws
# credentials) to use for the SLC submission quality check's Bedrock calls.
# Needed locally because AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY above are
# hardcoded to MinIO's dummy values in docker-compose.yml, which would
# otherwise shadow real AWS credentials for Bedrock too. Leave unset in
# production - the ECS task's IAM role is used instead.
BEDROCK_AWS_PROFILE=
# Optional: overrides the system-level instructions for the SLC submission
# quality check's LLM call (overall task framing, strictness, tone), so the
# check can be tuned per environment without a release. Leave empty to use
# the default baked into SubmissionQualityService. What each check means is
# defined by the output schema in code, not here.
SUBMISSION_QUALITY_INSTRUCTIONS=
# Optional: the same override for the claim name/address quality check's
# LLM call (OSDEV-3489). Leave empty to use the default baked into
# ClaimQualityService. Both checks invoke the model named by
# BEDROCK_SUBMISSION_QUALITY_MODEL_ID.
CLAIM_QUALITY_INSTRUCTIONS=
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
GOOGLE_SERVICE_ACCOUNT_CREDS_BASE64=
# Optional: id of the Contributor the Earth Genome candidate ingest writes
# under. Only that contributor may create candidate (empty name/address)
# facilities; leave empty and nobody can (OSDEV-3248).
EARTH_GENOME_CONTRIBUTOR_ID=
# Optional: Earth Genome candidate validation thresholds (OSDEV-3245).
# Defaults shown; states are derived from the live vote tally. Retirement
# is moderator-gated unless CANDIDATE_AUTO_RETIRE=True.
# CANDIDATE_VOTE_THRESHOLD=3
# CANDIDATE_CONFIRM_MARGIN=0.6
# CANDIDATE_RETIRE_MARGIN=0.75
# CANDIDATE_AUTO_RETIRE=False

# Optional: proximity suggestions for candidate facilities (OSDEV-3244).
# Confirmed facilities within this many metres of a candidate are suggested,
# nearest first, up to this many. Defaults: 500 m, 5.
CANDIDATE_SUGGESTION_RADIUS_M=
CANDIDATE_SUGGESTION_LIMIT=
