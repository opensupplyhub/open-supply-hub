#!/bin/bash
# Fail when Django model state and migrations have drifted further apart
# than the recorded baseline.
#
# `manage.py makemigrations --check` cannot be enabled directly: main
# already carries years of accumulated drift, captured in
# src/django/migration_drift_baseline.txt. This script ratchets
# instead: a PR that introduces a NEW model change without its
# migration fails, while the recorded drift is tolerated until it is
# burned down. When drift is resolved, regenerate the baseline with
# fewer lines; never add lines to it.
#
# The baseline records the full migration Django WOULD generate
# (`-v 3`), not just one summary line per changed field. A summary line
# reads the same however the field changed, so a further unmigrated
# change to a field already in the baseline would have compared equal
# and passed; the generated field definitions make that visible.
#
# Three lines of that output carry the next migration's number, which
# moves whenever any migration lands and has nothing to do with model
# drift, so they are filtered out rather than baselined.
#
# Runs the same `docker compose` Django image as the other code-quality
# checks, so it works locally and in CI.

set -euo pipefail

cd "$(dirname "$0")/.."

baseline="src/django/migration_drift_baseline.txt"
raw="$(mktemp)"
current="$(mktemp)"
trap 'rm -f "$raw" "$current"' EXIT

# Captured in two steps so a docker compose failure fails this check
# loudly instead of producing an empty change list that would read as
# resolved drift. Only grep's no-match (exit 1, a clean tree) is
# tolerated.
docker compose run --rm --no-deps --entrypoint python django \
    manage.py makemigrations --dry-run --no-color -v 3 > "$raw"
grep -vE "^# Generated by Django|api/migrations/[0-9]{4}_|Full migrations file '[0-9]{4}_|\('api', '[0-9]{4}_" \
    "$raw" > "$current" || [ $? -eq 1 ]

if diff -u "$baseline" "$current" > /dev/null; then
    echo "check_migration_drift: model state matches the recorded baseline."
    exit 0
fi

echo "check_migration_drift: model/migration drift changed." >&2
echo >&2
echo "Lines added below mean a model change without a migration:" >&2
echo "run 'python manage.py makemigrations', review the result, and" >&2
echo "commit it. Lines removed mean drift was resolved: shrink" >&2
echo "$baseline to match (never add lines to it)." >&2
echo >&2
diff -u "$baseline" "$current" >&2 || true
exit 1
