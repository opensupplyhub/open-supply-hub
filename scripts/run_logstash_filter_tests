#!/bin/bash

set -e

if [[ -n "${OAR_DEBUG}" ]]; then
    set -x
fi

function usage() {
    echo -n \
        "Usage: $(basename "$0")
Run the inline logstash Ruby filter tests, mirroring the
run-logstash-filter-tests CI job in .github/workflows/code_quality.yml.
"
}

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
    usage
    exit 0
fi

# Run from the repository root so the runner's relative paths resolve.
cd "$(dirname "$0")/.."

# Keep the image tag in sync with the run-logstash-filter-tests CI job.
docker run --rm -v "$PWD:/mnt" -w /mnt ruby:3.3-alpine \
    ruby src/logstash/tests/run_filter_tests.rb
