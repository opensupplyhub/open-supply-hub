#!/bin/bash
# Run pyright over ContriBot (src/contribot/pyrightconfig.json) and fail
# when the error count grows past the recorded ceiling.
#
# The codebase currently carries pre-existing pyright errors, so the
# check ratchets instead of blocking outright: new errors fail, the
# recorded ones are tolerated until burned down. When errors are fixed,
# lower MAX_ERRORS to the new count; never raise it.
#
# Requires pyright and ContriBot's requirements-dev to be installed for
# the active Python (CI uses 3.13 to match the Lambda runtime).

set -euo pipefail

MAX_ERRORS=109

cd "$(dirname "$0")/../src/contribot"

report="$(mktemp)"
trap 'rm -f "$report"' EXIT

pyright --outputjson > "$report" || true

errors="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['summary']['errorCount'])" "$report")"

if [ "$errors" -gt "$MAX_ERRORS" ]; then
    echo "check_contribot_types: $errors pyright errors (ceiling is $MAX_ERRORS)." >&2
    echo "New type errors were introduced. Full report:" >&2
    pyright >&2 || true
    exit 1
fi

echo "check_contribot_types: $errors pyright errors (ceiling $MAX_ERRORS)."
if [ "$errors" -lt "$MAX_ERRORS" ]; then
    echo "Error count dropped: lower MAX_ERRORS in $0 to $errors."
fi
