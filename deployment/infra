#!/bin/bash
set -e

if [[ -n "${OAR_DEBUG}" ]]; then
    set -x
fi

function usage() {
    echo -n \
"Usage: $(basename "$0") COMMAND OPTION[S]
Execute Terraform subcommands with remote state management.
"
}

# Lambda archives built from source by a per-function Makefile. Each one is
# gitignored: a zip is a build artifact, and committing one is exactly how the
# alert_* archives came to run 2023 bytes for years. Terraform hashes them via
# source_code_hash, so the apply job must see the same bytes the plan hashed --
# hence the S3 handoff below.
#
# The Lambda@Edge archives (add_security_headers, redirect_to_s3_origin) are
# deliberately absent: they have no Makefile and stay committed.
LAMBDA_ARCHIVES=(
    alert_batch_failures
    alert_sfn_failures
    contribot_fetch_lists
    contribot_process_list
    contribot_notify
    contribot_retry_failed_lists
)

function build_lambda_zips() {
    local lambda
    for lambda in "${LAMBDA_ARCHIVES[@]}"; do
        make -sC "lambda-functions/${lambda}"
    done
}

function upload_lambda_zips() {
    local lambda
    echo "Uploading Lambda archives to s3://${SETTINGS_BUCKET}/terraform/lambda/"
    for lambda in "${LAMBDA_ARCHIVES[@]}"; do
        aws s3 cp \
            "lambda-functions/${lambda}/${lambda}.zip" \
            "s3://${SETTINGS_BUCKET}/terraform/lambda/${lambda}.zip"
    done
}

function download_lambda_zips() {
    local lambda
    echo "Downloading Lambda archives from s3://${SETTINGS_BUCKET}/terraform/lambda/"
    for lambda in "${LAMBDA_ARCHIVES[@]}"; do
        aws s3 cp \
            "s3://${SETTINGS_BUCKET}/terraform/lambda/${lambda}.zip" \
            "lambda-functions/${lambda}/${lambda}.zip"
    done
}

function delete_lambda_zips() {
    local lambda
    echo "Deleting Lambda archives from s3://${SETTINGS_BUCKET}/terraform/lambda/"
    for lambda in "${LAMBDA_ARCHIVES[@]}"; do
        aws s3 rm "s3://${SETTINGS_BUCKET}/terraform/lambda/${lambda}.zip" || true
    done
}

# # Temporary solution
# GIT_COMMIT="latest"

if [[ -n "${GIT_COMMIT}" ]]; then
    GIT_COMMIT="${GIT_COMMIT:0:7}"
else
    SHORT_SHA="$(git rev-parse --short HEAD)"
    GIT_COMMIT="${SHORT_SHA:0:7}"

fi

if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    if [ "${1:-}" = "--help" ]; then
        usage
    else
        TERRAFORM_DIR="$(dirname "$0")/../deployment/terraform"
        echo
        echo "Attempting to deploy application version [${GIT_COMMIT}]..."
        echo "-----------------------------------------------------"
        echo
    fi

    if [[ -n "${SETTINGS_BUCKET}" ]]; then
        pushd "${TERRAFORM_DIR}"
        git config --global --add safe.directory /usr/local/src

        case "${1}" in
            plan)
                # DEFAULT_BATCH_CE_DESIRED_CPU=$(aws batch describe-compute-environments --output text --compute-environments "batch${OAR_DEPLOYMENT_ENVIRONMENT^}DefaultComputeEnvironment" --query "computeEnvironments[].computeResources.desiredvCpus")

                # Build Lambda function archives
                build_lambda_zips

                # Clear stale modules & remote state, then re-initialize
                echo "Terraform init"
                rm -rf .terraform terraform.tfstate*
                terraform init \
                  -backend-config="bucket=${SETTINGS_BUCKET}" \
                  -backend-config="key=terraform/state"
                echo "Terraform plan"
                terraform plan \
                          -no-color \
                          -var="image_tag=${GIT_COMMIT}" \
                          -var="batch_default_ce_desired_vcpus=${DEFAULT_BATCH_CE_DESIRED_CPU:-0}" \
                          -var-file="${SETTINGS_BUCKET}.tfvars" \
                          -out="${SETTINGS_BUCKET}.tfplan" \
                          > "${SETTINGS_BUCKET}.tfplan.log.txt" 2>&1

                # Pass the gitignored zips to the apply job (same bytes as plan)
                upload_lambda_zips
                ;;
            apply)
                # Use the exact archives hashed during plan
                download_lambda_zips

                echo "Terraform init"
                rm -rf .terraform terraform.tfstate*
                terraform init \
                  -backend-config="bucket=${SETTINGS_BUCKET}" \
                  -backend-config="key=terraform/state"
                echo "Terraform apply"
                ls -la
                terraform apply "${SETTINGS_BUCKET}.tfplan"
                delete_lambda_zips
                ;;
            destroy)
                # Build the gitignored Lambda archives. Terraform still
                # evaluates the full configuration when planning a destroy, so
                # filebase64sha256() fails if these zips are missing.
                build_lambda_zips

                echo "Terraform init"
                terraform init \
                  -backend-config="bucket=${SETTINGS_BUCKET}" \
                  -backend-config="key=terraform/state"
                terraform destroy \
                          -var="image_tag=${GIT_COMMIT}" \
                          -var="batch_default_ce_desired_vcpus=${DEFAULT_BATCH_CE_DESIRED_CPU:-0}" \
                          -var-file="${SETTINGS_BUCKET}.tfvars" \
                          --auto-approve \
                          -input=false
                ;;
            *)
                echo "ERROR: I don't have support for that Terraform subcommand!"
                exit 1
                ;;
        esac

        popd
    else
        echo "ERROR: No OAR_SETTINGS_BUCKET variable defined."
        exit 1
    fi
fi
