#!/bin/bash

vpc_id="$(aws ec2 describe-vpcs --filters=Name=tag:Name,Values=vpcOpenSupplyHub$1 --query 'Vpcs[*].VpcId' --output text)"
echo "VPC ID: $vpc_id"

security_groups="$(aws ec2 describe-security-groups --filters "Name=vpc-id,Values=$vpc_id" "Name=tag:Name,Values=sgAppEcsService" --query 'SecurityGroups[*].GroupId' --output text | sed 's/\t/,/g')"

echo "Security Group: $security_groups"

subnet_id="$(aws ec2 describe-subnets --filters=Name=vpc-id,Values=$vpc_id --query 'Subnets[].SubnetId' --output text | awk '{print $1}')"
echo "Subnet ID: $subnet_id"

revision="$(aws ecs describe-task-definition  --task-definition OpenSupplyHub${1}AppCLI --query 'taskDefinition.revision' --output text)"
echo "Revision: $revision"

echo "Running task with command: $2"

task_arn="$(aws ecs run-task \
    --cluster ecsOpenSupplyHub${1}Cluster \
    --task-definition=OpenSupplyHub${1}AppCLI:${revision} \
    --launch-type "FARGATE" \
    --network-configuration "awsvpcConfiguration={ assignPublicIp="ENABLED", securityGroups=["$security_groups"], subnets=["$subnet_id"]}" \
    --overrides "containerOverrides=[{name='django', command=["$2"]}]" \
    --query 'tasks[0].taskArn' \
    --output text)"

echo "Task ARN: $task_arn"
id=$(echo $task_arn | awk -F'/' '{print $NF}')
echo "Log Stream ID: $id"

echo "Task URL: https://eu-west-1.console.aws.amazon.com/ecs/v2/clusters/ecsOpenSupplyHub${1}Cluster/tasks/$id"

echo "Waiting for task to stop..."
res=1
while [ $res -ne 0 ]; do
    echo "Continue waiting: $(date +%T)"
    aws ecs wait tasks-stopped --cluster "ecsOpenSupplyHub${1}Cluster" --tasks "${task_arn}"
    res=$?
done

echo "Stop time: $(date +%T)"

echo "Task stopped reason:"
aws ecs describe-tasks --cluster ecsOpenSupplyHub${1}Cluster --tasks ${task_arn} --query 'tasks[0].[stoppedReason]'


# Captured before the logs are fetched, so a failed log retrieval cannot mask
# the container's own result. Selected by container name rather than by
# position, because describe-tasks does not guarantee the order of containers[]
# and a sidecar added later must not be able to answer for the django one.
#
# Retried because a transient describe-tasks failure produces no output, which
# is otherwise indistinguishable from a container that never ran and would fail
# a deploy whose command had in fact succeeded. Only an API failure is retried;
# a reported null exit code is an answer, not an error.
exit_code=""
for describe_attempt in 1 2 3; do
    if exit_code="$(aws ecs describe-tasks \
        --cluster ecsOpenSupplyHub${1}Cluster \
        --tasks ${task_arn} \
        --query "tasks[0].containers[?name=='django'].exitCode | [0]" \
        --output text)"; then
        break
    fi
    echo "describe-tasks failed (attempt $describe_attempt of 3)." >&2
    exit_code=""
    if [ "$describe_attempt" -lt 3 ]; then
        sleep 5
    fi
done
echo "Container exit code: $exit_code"

echo "----- Log Stream -----"
echo ""
echo ""
aws logs get-log-events --log-group-name "logOpenSupplyHub${1}AppCLI" --log-stream-name "management/django/$id" --query 'events[*].[message]' --output text
echo ""
echo ""
echo "----- Log Stream end -----"

# A task killed before the container ran (OOM, ENI failure, image pull error)
# reports a null exitCode, which the CLI renders as "None" - that is a failure,
# not a success. An unreadable exit code is treated the same way.
case "$exit_code" in
    0)
        exit 0
        ;;
    ''|None|null)
        echo "ERROR: no container exit code reported - the container did not run to completion." >&2
        echo "Check the stopped reason above and the Task URL." >&2
        exit 1
        ;;
    *)
        echo "ERROR: container exited with code $exit_code." >&2
        exit "$exit_code"
        ;;
esac
