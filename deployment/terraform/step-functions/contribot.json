{
    "StartAt": "ChooseSource",
    "States": {
        "ChooseSource": {
            "Type": "Choice",
            "Choices": [
                {
                    "Variable": "$.lists",
                    "IsPresent": true,
                    "Next": "ProcessLists"
                }
            ],
            "Default": "FetchLists"
        },
        "FetchLists": {
            "Type": "Task",
            "Resource": "${fetch_lists_lambda_arn}",
            "Next": "ProcessLists"
        },
        "ProcessLists": {
            "Type": "Map",
            "ItemsPath": "$.lists",
            "Iterator": {
                "StartAt": "ProcessList",
                "States": {
                    "ProcessList": {
                        "Type": "Task",
                        "Resource": "${process_list_lambda_arn}",
                        "Next": "Notify",
                        "Catch": [
                            {
                                "ErrorEquals": [
                                    "ListUnderReview"
                                ],
                                "ResultPath": "$.error",
                                "Next": "LeaveForRetry"
                            },
                            {
                                "ErrorEquals": [
                                    "States.ALL"
                                ],
                                "ResultPath": "$.error",
                                "Next": "Notify"
                            }
                        ]
                    },
                    "LeaveForRetry": {
                        "Type": "Pass",
                        "Comment": "The contributor's list-cleaning review window is still open (OSDEV-3398): process_list left the list FAILED for retry_failed_lists to bring back, and nobody is notified.",
                        "End": true
                    },
                    "Notify": {
                        "Type": "Task",
                        "Resource": "${notify_lambda_arn}",
                        "End": true
                    }
                }
            },
            "End": true
        }
    }
}
